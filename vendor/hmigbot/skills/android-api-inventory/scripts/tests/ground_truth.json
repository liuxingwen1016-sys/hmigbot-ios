{
  "_note": "独立真值：逐字读 fixtures/*.kt 得到（非跑脚本导出，破循环）。每个 endpoint 的 params = 源码里真实声明的全部参数。",
  "endpoints": [
    {
      "method_name": "sendSmsCode", "http_method": "POST", "path": "/auth/sendSmsCode",
      "params": ["mobile", "bizType"],
      "gap": "baseline-control（短签名，应全过）"
    },
    {
      "method_name": "register", "http_method": "POST", "path": "/auth/register",
      "params": ["username", "password", "mobile", "smsCode", "nickname", "avatar", "gender", "birthday", "city", "channel", "deviceId", "inviteCode", "appVersion", "osType", "infoSource", "registerType"],
      "gap": "#1 >15 行签名截断（16 参，闭括号在窗口外）"
    },
    {
      "method_name": "searchItems", "http_method": "GET", "path": "/search/items",
      "params": ["keyword", "infoSource", "ids"],
      "gap": "#3 vararg（ids 预测漏；infoSource 是普通参、应抽到）"
    },
    {
      "method_name": "filter", "http_method": "GET", "path": "/search/filter",
      "params": ["filters", "page"],
      "param_types": {"filters": "Map<String, String>"},
      "gap": "#2 generic 类型逗号截断（filters 类型预测截成 Map<String）"
    },
    {
      "method_name": "createOrder", "http_method": "POST", "path": "/order/create",
      "params": ["request", "token"],
      "resolved_path": "/order/create",
      "body_dto_fields": ["productId", "quantity", "couponId", "addressId", "remark"],
      "gap": "#4 @Body DTO 字段不展开（lane-gap）+ const-ref 路径解析（基线，应 resolve）"
    },
    {
      "method_name": "cancelOrder", "http_method": "DELETE", "path": "/order/cancel",
      "params": ["request"],
      "gap": "#6 @HTTP 自定义方法（预测整个 endpoint 漏）"
    },
    {
      "method_name": "updateProfile", "http_method": "POST", "path": "/profile/update",
      "params": ["nickname", "avatar", "gender", "birthday", "signature", "city", "province", "country", "company", "position", "school", "industry", "website", "email", "phone", "wechat", "weibo", "tags"],
      "gap": "#1 泛化（18 参 + 夹空行/注释，异于 register 形，跨 ~22 行）"
    },
    {
      "method_name": "getProfile", "http_method": "GET", "path": "/profile/{uid}",
      "params": ["uid", "fields"],
      "gap": "泛化对照：@Path/@Query 混合 + nullable String?"
    },
    {
      "method_name": "batchGet", "http_method": "POST", "path": "/profile/batchGet",
      "params": ["ids", "filter"],
      "param_types": {"filter": "Map<String, List<String>>"},
      "gap": "#2 泛化：嵌套泛型 Map<String, List<String>>（一级嵌套）"
    }
  ]
}
